# Optional: enables cross-device realtime rooms. Without it, the app uses
# BroadcastChannel for same-origin tabs on one device.
VITE_COLLAB_WS_URL=ws://localhost:8787

# Collaboration server port used by `npm run collab`.
COLLAB_PORT=8787

# Production uses same-origin Cloudflare Access + Durable Objects automatically.
# DATABASE_URL is a Worker secret and must never be exposed as a VITE_ variable.
