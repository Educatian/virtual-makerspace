{
  "name": "virtual-makerspace",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "collab": "node server/collaboration.mjs",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p .",
    "test:circuit": "node --experimental-strip-types scripts/circuit-engine-check.mjs",
    "test:agent": "node --experimental-strip-types scripts/teachable-agent-check.mjs",
    "test:project": "node --experimental-strip-types scripts/project-state-check.mjs",
    "test:snapino": "node --experimental-strip-types scripts/snapino-check.mjs && node --experimental-strip-types scripts/snapino-sketch-check.mjs",
    "test": "npm run typecheck && npm run test:circuit && npm run test:agent && npm run test:project && npm run test:snapino",
    "test:e2e": "node scripts/e2e-ai-teammate.mjs",
    "test:e2e:worker": "node scripts/e2e-ai-teammate-worker.mjs",
    "qa:3d": "node scripts/qa-3d.mjs"
  },
  "dependencies": {
    "@fontsource/inter": "^5.3.0",
    "@iwsdk/core": "0.3.1",
    "@phosphor-icons/web": "^2.1.2",
    "three": "npm:super-three@0.181.0",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@felixtz/iwsdk-rag-mcp": "^0.3.1",
    "@iwsdk/vite-plugin-dev": "0.3.1",
    "@iwsdk/vite-plugin-uikitml": "0.3.1",
    "@meta-quest/hzdb": "^1.0.0",
    "@types/three": "*",
    "typescript": "^5.5.0",
    "vite": "^7.1.4",
    "vite-plugin-mkcert": "^1.17.0"
  },
  "engines": {
    "node": ">=20.19.0"
  }
}
