<style>
  .hud {
    background-color: #0a0a0a;
    border-radius: 2;
    padding: 2;
    width: 50;
    border-color: #00ff66;
    border-width: 0.2;
    display: flex;
    flex-direction: column;
  }

  .progress {
    font-size: 1.6;
    color: #00ff66;
    text-align: left;
    margin-bottom: 0.6;
  }

  .step {
    font-size: 2.2;
    color: #f0f0f0;
    text-align: left;
    line-height: 1.3;
  }
</style>
<div class="hud">
  <span id="progress" class="progress">Step - / -</span>
  <span id="step" class="step">Loading...</span>
</div>
