<style>
  .card {
    background-color: #141a26;
    border-color: #2a3245;
    border-width: 0.15;
    border-radius: 1.6;
    padding: 1.4;
    width: 64;
    display: flex;
    flex-direction: column;
    gap: 0.6;
  }

  .prompt {
    font-size: 1.4;
    color: #e8eef7;
    line-height: 1.3;
  }

  .row {
    display: flex;
    flex-direction: row;
    align-items: center;
    gap: 0.6;
  }

  .mic-button {
    font-size: 1.6;
    color: #9aa6bd;
    padding: 0.3;
    hover:color: #e8eef7;
  }

  .voice-label {
    font-size: 1.1;
    color: #9aa6bd;
    flex-grow: 1;
  }

  .voice-recognized {
    font-size: 1.1;
    color: #e8eef7;
    line-height: 1.3;
    flex-grow: 1;
  }

  .edit-btn {
    font-size: 0.95;
    color: #9aa6bd;
    padding: 0.3;
    hover:color: #e8eef7;
  }

  .use-chips-toggle {
    font-size: 0.95;
    color: #9aa6bd;
    padding: 0.2;
    text-align: center;
    hover:color: #e8eef7;
  }

  .chip-row {
    display: flex;
    flex-direction: row;
    gap: 0.4;
  }

  .chip {
    background-color: #1f2738;
    border-color: #3a4258;
    border-width: 0.08;
    border-radius: 0.6;
    padding: 0.5;
    color: #e8eef7;
    font-size: 1.0;
    text-align: center;
    flex-grow: 1;
    hover:background-color: #2a3550;
  }

  .bottom-row {
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    margin-top: 0.3;
  }

  .skip {
    background-color: transparent;
    border-color: transparent;
    color: #9aa6bd;
    font-size: 1.05;
    padding: 0.4;
    hover:color: #e8eef7;
  }

  .submit {
    background-color: #1f2738;
    color: #9aa6bd;
    font-size: 1.1;
    padding: 0.55;
    border-radius: 0.6;
  }
</style>
<div class="card">
  <span id="prompt" class="prompt">Before you place this again — what do you expect to be different?</span>
  <div id="voice-row" class="row">
    <span id="mic-button" class="mic-button">rec</span>
    <span id="voice-label" class="voice-label">Tap mic to speak</span>
  </div>
  <div id="voice-captured-row" class="row">
    <span id="voice-recognized" class="voice-recognized"></span>
    <span id="edit-btn" class="edit-btn">edit</span>
  </div>
  <span id="use-chips" class="use-chips-toggle">Use chips instead</span>
  <div id="chip-row" class="chip-row">
    <span id="chip-position" class="chip">different position</span>
    <span id="chip-orientation" class="chip">different orientation</span>
    <span id="chip-other" class="chip">something else</span>
  </div>
  <div class="bottom-row">
    <span id="skip" class="skip">skip</span>
    <span id="submit" class="submit">submit</span>
  </div>
</div>
